{
  "name": "proofpay-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Verra Seeker/Android app — proof of real-world work into programmable payment",
  "main": "App.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "apk": "expo prebuild --platform android --no-install && ./android/gradlew -p android assembleDebug",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest && npm run test:node",
    "test:node": "ts-mocha -p ./tsconfig.json -t 10000 tests/solana-backend.test.ts",
    "secrets-check": "node scripts/check-no-secrets.js"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@noble/curves": "^1.4.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@solana-mobile/mobile-wallet-adapter-protocol": "^2.1.0",
    "@solana-mobile/mobile-wallet-adapter-protocol-web3js": "^2.1.0",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.0",
    "buffer": "^6.0.3",
    "expo": "~52.0.0",
    "expo-application": "~6.0.1",
    "expo-crypto": "~14.0.1",
    "expo-image-picker": "~16.0.3",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "~4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/chai": "^4.3.11",
    "@types/jest": "^29.5.0",
    "@types/mocha": "^10.0.7",
    "@types/react": "~18.3.12",
    "babel-preset-expo": "~12.0.0",
    "chai": "^4.3.10",
    "jest": "~29.7.0",
    "jest-expo": "~52.0.0",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.5.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "tests/solana-backend.test.ts"
    ]
  }
}
