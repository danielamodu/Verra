{
  "compilerOptions": {
    "types": ["node", "mocha"],
    "typeRoots": ["./node_modules/@types"],
    "lib": ["es2020"],
    "module": "commonjs",
    "target": "es2020",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true
  },
  "include": ["tests/**/*.ts", "verification/**/*.ts", "helpers/**/*.ts"],
  "exclude": ["node_modules", "dist", "target"]
}
