{
  "name": "verra-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Verra backend — jobs, submissions, verification, attestations, settlement, activity",
  "license": "MIT",
  "scripts": {
    "dev": "npx ts-mocha -p ./tsconfig.json src/server.ts",
    "start": "node dist/backend/src/server.js",
    "build": "npx tsc -p tsconfig.json --outDir dist",
    "lint": "npx tsc --noEmit -p tsconfig.json",
    "test": "npx ts-mocha -p ./tsconfig.json -t 30000 \"tests/**/*.test.ts\"",
    "test:slice": "RUN_CHAIN_SLICE=1 npx ts-mocha -p ./tsconfig.json -t 1000000 tests/vertical-slice.test.ts",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:studio": "npx prisma studio"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@noble/curves": "^1.4.0",
    "@prisma/client": "^6.0.0",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.0",
    "bs58": "^4.0.1",
    "express": "^4.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bs58": "^4.0.1",
    "@types/chai": "^4.3.11",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.0",
    "@types/supertest": "^2.0.16",
    "chai": "^4.3.10",
    "mocha": "^11.0.1",
    "prisma": "^6.0.0",
    "supertest": "^6.3.3",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.5.0"
  }
}
