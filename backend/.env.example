# Copy to .env and fill in. Never commit .env.
PORT=4000
DATABASE_URL=postgresql://xbt@/verra?host=/tmp
RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=EmAPVEMNMa5vmS2GaFSjfNjg1JeWyUhy4fCe3c6PyoMp
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Backend-only secret: verifier keypair JSON. Never ships to mobile,
# never returned by the API, never logged.
VERIFIER_KEYPAIR_PATH=/home/xbt/.config/solana/verra-verifier.json
STORAGE_DIR=./.storage

# --- SKR bond-gating (verra_bond). Set all three to ACTIVATE fail-closed
#     bond checks before verify_job authorization. Leave unset for the
#     untouched USDC baseline. SKR_MINT below is a MOCK devnet mint — NOT
#     real SKR. See docs/skr-bond.md.
BOND_PROGRAM_ID=fza6wCHJfcQ3DVDjPg7vmC3zJGgTQymKoN844by3qBy
SKR_MINT=AQQatwcmW5v14uXtdKHsCKFMRt2hiNUrBUEaYg8qTFQE
MIN_BOND=100000000000
